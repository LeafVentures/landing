# KlimaKarma Landing — Produktions-Umgebung
# Lokal ohne diese Werte läuft die Seite mit eingebettetem PGLite (nicht persistent).

# Echtes Postgres für die Warteliste (persistent). Neon ODER die Supabase-DB der App.
# Supabase: Connection String aus dem Dashboard (Settings → Database → Connection string, "URI").
# Mit Supabase landen die Waitlist-Einträge in derselben DB wie die App (Tabelle public.waitlist).
DATABASE_URL=postgresql://USER:PASSWORT@HOST:5432/postgres

# Öffentlicher Hostname (für Canonical/OG).
VITE_PUBLIC_HOSTNAME=klimakarma.app

# Der plattform-föderierte Login (Grok-Broker) funktioniert außerhalb der Builder-Sandbox
# nicht und wird für die Marketing-Seite nicht gebraucht — ausschalten.
VITE_AUTH_ENABLED=false
